{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "node_modules", "apps"],
  "compilerOptions": {
    "paths": {
      "~/*": ["public/*"],
      "@/*": ["src/*"]
    },
    "allowJs": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  }
}
