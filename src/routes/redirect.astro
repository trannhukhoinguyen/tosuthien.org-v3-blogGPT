---
import { localeInfo } from '../lib/translations';
import config from '../lib/config';
import { href, localize, t } from '@/lib/i18n';
import { htmlRoutes } from '../lib/html-routes';
import { pageLocale } from '@/lib/i18n';
import Layout from '@/layouts/Layout.astro';
import SearchBox from '@/components/SearchBox.astro';
import PostList from '@/components/PostList.astro';
import ThemeIcon from '@/components/ThemeIcon.astro';
import { postsFor } from '@/lib/content';
const lang = pageLocale(Astro.routePattern);
const posts = (await postsFor(lang)).slice(0, config.posts.homeLimit);
const ui = t(lang);
export async function getStaticPaths() {
  const prefix = href(config.site.defaultLocale);
  return (await htmlRoutes(config.site.defaultLocale)).map((target) => ({
    params: {
      unprefixed:
        decodeURI(target.slice(prefix.length)).replace(/\/$/, '') || undefined,
    },
    props: { target },
  }));
}
interface Props {
  target: string;
}
const { target } = Astro.props;
---


<Layout lang={localeInfo(config.site.defaultLocale).lang} active="home">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex,nofollow" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <title>{localize(config.site.title, config.site.defaultLocale)}</title>
    <link rel="canonical" href={new URL(target, config.site.url).href} />
    <script is:inline define:vars={{ target }}>
      // Retain search queries and paragraph fragments when JavaScript is available.
      if (location.search || location.hash)
        location.replace(target + location.search + location.hash);
    </script>
  </head>
  <section class="home-stage" aria-label={ui.home}>
    <div class="home-heading-anchor">
      <div class="home-heading-text">
        <h1>{localize(config.text.homeHeading, lang)}</h1>
      </div>
    </div>
    <div class="content-column home-composer-wrap">
      <SearchBox lang={lang} home />
    </div>
  </section>
  <div class="content-column home-recent">
    <section>
      <div class="section-heading">
        <h2>{ui.recent}</h2>
        <a href={href(lang, 'posts/')}>
          {ui.allPosts}
          <ThemeIcon name="arrow-right" size={15} />
        </a>
      </div>
      <PostList posts={posts} lang={lang} compact />
    </section>
  </div>
</Layout>
